<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AsistenteIA.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AsistenteIA.ViewModels"
    x:DataType="vm:DetailViewModel"
    Title="Detalle">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="{StaticResource ContentMaxWidth}">

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasRecord}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Pregunta" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding Record.Prompt}" Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasRecord}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Respuesta" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding Record.Answer}" Style="{StaticResource Body}" />
                    <Label Text="⚠ Contenido generado con IA. No es una fuente autorizada." Style="{StaticResource Caption}" FontAttributes="Italic" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasRecord}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                    <Label Text="Fecha" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Record.CreatedAtLocal}" VerticalOptions="Center" />

                    <Label Grid.Row="1" Text="Modelo" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Record.Model}" VerticalOptions="Center" />

                    <Label Grid.Row="2" Text="Categoría" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <Picker Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
                            SemanticProperties.Description="Categoría de la conversación" />

                    <Label Grid.Row="3" Text="Verificada" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Switch IsToggled="{Binding IsVerified}" VerticalOptions="Center"
                                SemanticProperties.Description="Marcar respuesta como verificada" />
                        <Label Grid.Column="1" Text="Contrasté la respuesta con fuentes confiables" FontSize="13" VerticalOptions="Center"
                               LineBreakMode="WordWrap" />
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasRecord}" Padding="8">
                <Editor Text="{Binding Notes}" Placeholder="Notas: fuentes consultadas, correcciones..."
                        AutoSize="TextChanges" MinimumHeightRequest="80"
                        SemanticProperties.Description="Notas de verificación" />
            </Border>

            <Label Text="{Binding StatusMessage}" Style="{StaticResource Caption}" HorizontalTextAlignment="Center" FontAttributes="Bold"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource HasText}}" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" IsVisible="{Binding HasRecord}">
                <Button Grid.ColumnSpan="2" Text="Guardar cambios" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}"
                        SemanticProperties.Hint="Actualiza la conversación en la base de datos" />
                <Button Grid.Row="1" Text="Copiar" Command="{Binding CopyCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Row="1" Grid.Column="1" Text="Compartir" Command="{Binding ShareCommand}" Style="{StaticResource SecondaryButton}" />
            </Grid>
            <Button Text="Eliminar conversación" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"
                    IsVisible="{Binding HasRecord}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
