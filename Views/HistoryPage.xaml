<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AsistenteIA.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AsistenteIA.ViewModels"
    xmlns:m="clr-namespace:AsistenteIA.Models"
    x:DataType="vm:HistoryViewModel"
    Title="Historial">

    <Grid RowDefinitions="Auto,*" Padding="16,12,16,0" RowSpacing="8" MaximumWidthRequest="{StaticResource ContentMaxWidth}">

        <!-- Filtros -->
        <VerticalStackLayout Spacing="6">
            <SearchBar Text="{Binding SearchText}" Placeholder="Buscar en preguntas y respuestas"
                       SemanticProperties.Description="Buscar conversaciones" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Picker Title="Categoría" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategory}"
                        SemanticProperties.Description="Filtrar por categoría" />
                <Label Grid.Column="1" Text="Solo verificadas" VerticalOptions="Center" FontSize="13" />
                <Switch Grid.Column="2" IsToggled="{Binding OnlyVerified}" VerticalOptions="Center"
                        SemanticProperties.Description="Mostrar solo conversaciones verificadas" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Quitar filtros" Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" />
            </Grid>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Records}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8">
                        <Label Text="📭" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="{Binding EmptyMessage, Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, x:DataType=vm:HistoryViewModel}"
                               HorizontalTextAlignment="Center" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:ConversationRecord">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="Eliminar" BackgroundColor="{StaticResource Danger}"
                                               Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, x:DataType=vm:HistoryViewModel}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource Card}" Padding="12"
                                    SemanticProperties.Description="{Binding Prompt}"
                                    SemanticProperties.Hint="Toque para ver el detalle">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, x:DataType=vm:HistoryViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                    <Label Text="{Binding Prompt}" FontFamily="OpenSansSemibold" FontSize="15"
                                           MaxLines="2" LineBreakMode="TailTruncation" />
                                    <Button Grid.Column="1" Grid.RowSpan="2" Text="🗑" FontSize="18"
                                            Style="{StaticResource DangerButton}" Padding="0" WidthRequest="44" HeightRequest="44"
                                            VerticalOptions="Start"
                                            Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, x:DataType=vm:HistoryViewModel}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Eliminar conversación" />
                                    <Label Grid.Row="1" Text="{Binding Answer}" Style="{StaticResource Caption}"
                                           MaxLines="2" LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                                        <Border Style="{StaticResource Chip}">
                                            <Label Text="{Binding Category}" FontSize="11" />
                                        </Border>
                                        <Label Text="{Binding VerificationText}" FontSize="11" VerticalOptions="Center"
                                               TextColor="{Binding IsVerified, Converter={StaticResource VerifiedColor}}" FontAttributes="Bold" />
                                        <Label Text="{Binding CreatedAtLocal}" FontSize="11" VerticalOptions="Center" Style="{StaticResource Caption}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <ContentView HeightRequest="16" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
