<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AsistenteIA"
             xmlns:conv="clr-namespace:AsistenteIA.Converters"
             x:Class="AsistenteIA.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:StatusKindToColorConverter x:Key="StatusColor" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
            <conv:HasTextConverter x:Key="HasText" />
            <conv:VerifiedToColorConverter x:Key="VerifiedColor" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
